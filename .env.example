# Supabase Configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Make.com Webhooks
MAKE_WEBHOOK_URL_LIKE_EVENT=https://hook.make.com/xxxxx

# Search API (choose one)
# Option A: Google Custom Search
GOOGLE_SEARCH_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Option B: Bing Web Search
BING_SEARCH_API_KEY=your_bing_api_key

# Gmail Configuration (for Make.com)
EVENTS_INBOX_EMAIL=nyc-events@gmail.com

# Optional: For future frontend
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
